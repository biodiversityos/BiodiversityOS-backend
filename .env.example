PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud
PORT=3000
# Registry used to check whether an uploader is an accredited reporter
CONTRACT_ADDRESS=0x...
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
